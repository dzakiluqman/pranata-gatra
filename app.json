{
  "expo": {
    "name": "Pranata Gatra",
    "slug": "pranata-gatra",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/pranata-gatra-icon.png",
    "scheme": "pranatagatra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.dzakiluqman.pranatagatra",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/pranata-gatra-foreground.png",
        "backgroundImage": "./assets/images/pranata-gatra-background.png",
        "monochromeImage": "./assets/images/pranata-gatra-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dzakiluqman.pranatagatra",
      "versionCode": 2,
      "runtimeVersion": "1.0.1"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#B38D46",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8bd95e85-5453-4375-895f-1fe9c79de6f7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/8bd95e85-5453-4375-895f-1fe9c79de6f7"
    }
  }
}
